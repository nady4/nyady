@use "./variables" as *;

.product-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  margin-top: 90px;
  min-height: 100vh;

  .product-detail {
    display: flex;
    gap: 4rem;
    width: 100%;
    max-width: 1500px;
    margin-bottom: 4rem;

    .product-image-container {
      flex: 1;
      position: relative;
      aspect-ratio: 1;
      border-radius: 1rem;
      overflow: hidden;
      background-color: $bg-secondary;
      border: 1px solid $border-color;

      .product-image {
        object-fit: cover;
        width: 100%;
        height: 100%;
      }

      .image-navigation {
        position: absolute;
        bottom: 1rem;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;

        .nav-button {
          width: 36px;
          height: 36px;
          border: none;
          border-radius: 50%;
          background-color: rgba(0, 0, 0, 0.5);
          color: white;
          font-size: 1.5rem;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: background-color 0.2s ease;

          &:hover {
            background-color: rgba(0, 0, 0, 0.7);
          }
        }

        .image-dots {
          display: flex;
          gap: 0.5rem;

          .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: none;
            background-color: rgba(255, 255, 255, 0.4);
            cursor: pointer;
            transition: all 0.2s ease;
            padding: 0;

            &:hover {
              background-color: rgba(255, 255, 255, 0.7);
            }

            &.active {
              background-color: white;
              transform: scale(1.2);
            }
          }
        }
      }
    }

    .product-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.5rem;

      .product-name {
        font-family: $title-font;
        font-size: 2.5rem;
        font-weight: 600;
        color: $text-color;
        margin: 0;
      }

      .product-price {
        font-family: $title-font;
        font-size: 2rem;
        font-weight: 700;
        color: $accent-color;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;

        .price-discounted {
          &.discount-10 {
            color: #4a8a42;
          }
          &.discount-20 {
            color: #65a856;
          }
        }

        .discount-badge {
          font-size: 0.875rem;
          font-weight: 600;
          color: white;
          background-color: #22c55e;
          padding: 0.25rem 0.5rem;
          border-radius: 0.25rem;
        }
      }

      .product-description {
        font-family: $body-font;
        font-size: 1rem;
        line-height: 1.6;
        color: $text-color;
        opacity: 0.8;
        margin: 0;
      }

      .product-code {
        font-family: $body-font;
        font-size: 0.875rem;
        color: $text-color;
        opacity: 0.6;
        margin: 0;
      }

      .product-size {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        .size-label {
          font-family: $body-font;
          font-size: 1rem;
          font-weight: 500;
          color: $text-color;
        }

        .size-selector {
          display: flex;
          flex-wrap: wrap;
          gap: 0.5rem;
          max-width: 550px;
        }

        .size-option {
          min-width: 40px;
          height: 40px;
          padding: 0 0.75rem;
          border: 1px solid $border-color;
          border-radius: 0.25rem;
          background-color: transparent;
          cursor: pointer;
          font-family: $body-font;
          font-size: 0.875rem;
          color: $text-color;
          transition: all 0.2s ease;

          &:hover {
            border-color: $accent-color;
          }

          &.selected {
            background-color: $accent-color;
            border-color: $accent-color;
            color: black;
          }
        }
      }

      .product-color {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        .color-label {
          font-family: $body-font;
          font-size: 1rem;
          font-weight: 500;
          color: $text-color;
        }

        .color-selector {
          display: flex;
          gap: 0.5rem;
        }

        .color-circle {
          width: 24px;
          height: 24px;
          border-radius: 50%;
          border: 2px solid transparent;
          cursor: pointer;
          transition: all 0.2s ease;
          outline: 2px solid $border-color;
          outline-offset: 2px;

          &:hover {
            transform: scale(1.1);
          }

          &.selected {
            border-color: $text-color;
            outline-color: $accent-color;
          }
        }
      }

      .product-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
        flex-wrap: wrap;

        .wishlist-button {
          width: 48px;
          height: 48px;
          border: 1px solid $border-color;
          border-radius: 0.5rem;
          background-color: transparent;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: all 0.2s ease;

          &:hover {
            border-color: $accent-color;
          }

          &.active {
            background-color: rgba(231, 76, 60, 0.1);
            border-color: $accent-color;
          }
        }

        .quantity-controls {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          border: 1px solid $border-color;
          border-radius: 0.5rem;
          padding: 0.25rem;

          button {
            width: 36px;
            height: 36px;
            border: none;
            background-color: transparent;
            cursor: pointer;
            font-size: 1.25rem;
            font-weight: 600;
            color: $text-color;
            transition: background-color 0.2s ease;

            &:hover {
              background-color: $bg-secondary;
            }
          }

          span {
            min-width: 2rem;
            text-align: center;
            font-family: $body-font;
            font-size: 1rem;
            font-weight: 500;
          }
        }

        .cart-button {
          flex: 1;
          height: 48px;
          border: 1px solid $border-color;
          border-radius: 0.5rem;
          background-color: $accent-color;
          color: black;
          font-family: $title-font;
          font-size: 1rem;
          font-weight: 600;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
          transition: all 0.2s ease;

          &:hover {
            opacity: 0.9;
          }
        }

        .discount-info {
          display: flex;
          flex-direction: column;
          gap: 0.25rem;
          padding: 0.4rem 0.6rem;
          background-color: rgba(34, 197, 94, 0.15);
          border: 1px solid #22c55e;
          border-radius: 0.4rem;

          .discount-tier {
            font-family: $body-font;
            font-size: 0.8rem;
            font-weight: 600;
            color: #16a34a;
            margin: 0;
          }
        }

        .discount-subtotal {
          display: flex;
          flex-direction: column;
          gap: 0.25rem;
          padding: 0.75rem;
          background-color: rgba($accent-color, 0.1);
          border-radius: 0.5rem;

          .subtotal-original {
            font-family: $body-font;
            font-size: 0.9rem;
            color: $text-muted;
            text-decoration: line-through;
            font-weight: 400;

            span {
              font-weight: 600;
              text-decoration: line-through;
            }
          }

          .subtotal-discount {
            font-family: $body-font;
            font-size: 0.9rem;
            color: $text-muted;
            margin-top: 0.25rem;

            span {
              font-weight: 600;
              color: #16a34a;
            }
          }
        }

        .cart-button {
          display: flex;
          flex-direction: column;
          align-items: center;
          width: 100%;
          margin-top: 4rem;
          margin-bottom: 4rem;
          gap: 1.5rem;

          h2 {
            font-family: $title-font;
            font-size: 1.75rem;
            font-weight: 500;
            color: $text-color;
            margin-bottom: 1rem;
            text-align: center;
          }

          .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr);
      gap: 1.5rem;
      width: 100%;
      max-width: 1400px;
      padding: 0 1rem;

      .product {
        background-color: $bg-secondary;
        border: 1px solid $border-color;
        border-radius: 1rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        transition:
          box-shadow 0.2s ease,
          transform 0.2s ease;
        cursor: pointer;

        &:hover {
          box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
          transform: translateY(-4px);
        }

        &:active {
          transform: scale(0.98);
        }

        .name {
          font-family: $title-font;
          font-size: 1.1rem;
          font-weight: 500;
          margin-top: 1rem;
          color: $text-color;
          text-align: center;
        }

        .price {
          font-family: $title-font;
          font-size: 1.2rem;
          font-weight: 600;
          color: $logo-color;
          margin-top: 0.5rem;
        }
      }
    }
  }
}

@media screen and (max-width: 768px) {
  .product-page {
    padding: 1rem;
    padding-bottom: 3rem;
    margin-top: 80px;

    .product-detail {
      flex-direction: column;
      gap: 2rem;

      .product-image-container {
        aspect-ratio: 1;
        width: 100%;

        .image-navigation {
          .nav-button {
            width: 32px;
            height: 32px;
            font-size: 1.25rem;
          }

          .image-dots {
            gap: 0.4rem;

            .dot {
              width: 8px;
              height: 8px;
            }
          }
        }
      }

      .product-info {
        .product-name {
          font-size: 1.75rem;
        }

        .product-price {
          font-size: 1.5rem;

          .discount-badge {
            font-size: 0.75rem;
            padding: 0.2rem 0.4rem;
          }
        }

        .product-description {
          font-size: 0.9rem;
        }

        .product-size {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;

          .size-selector {
            max-width: 100%;
          }

          .size-option {
            min-width: 36px;
            height: 36px;
            padding: 0 0.5rem;
            font-size: 0.8rem;
          }
        }

        .product-color {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;

          .color-selector {
            gap: 0.4rem;
          }

          .color-circle {
            width: 22px;
            height: 22px;
          }
        }

        .product-actions {
          flex-wrap: wrap;
          gap: 0.75rem;

          .wishlist-button {
            width: 42px;
            height: 42px;
          }

          .quantity-controls {
            button {
              width: 32px;
              height: 32px;
              font-size: 1.1rem;
            }

            span {
              min-width: 1.5rem;
              font-size: 0.9rem;
            }
          }

          .cart-button {
            width: 100%;
            order: -1;
            height: 44px;
            font-size: 0.95rem;
          }

          .discount-info {
            width: 100%;
            padding: 0.4rem 0.6rem;

            .discount-tier {
              font-size: 0.75rem;
            }
          }

          .discount-subtotal {
            width: 100%;
            padding: 0.5rem;

            .subtotal-original {
              font-size: 0.8rem;
            }

            .subtotal-discount {
              font-size: 0.9rem;
            }
          }
        }
      }
    }

    .related-products {
      margin-top: 2rem;
      margin-bottom: 2rem;
      gap: 1rem;

      h2 {
        font-size: 1.5rem;
      }

      .products {
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr);
        gap: 1rem;
        padding: 0 0.5rem;

        .product {
          padding: 1rem;

          .name {
            font-size: 1rem;
            margin-top: 0.75rem;
          }

          .price {
            font-size: 1.1rem;
          }
        }
      }
    }
  }
}

@media screen and (max-width: 480px) {
  .product-page {
    padding: 0.75rem;
    margin-top: 70px;

    .product-detail {
      gap: 1.5rem;
      margin-bottom: 2rem;

      .product-image-container {
        border-radius: 0.75rem;

        .image-navigation {
          bottom: 0.75rem;
          gap: 0.75rem;

          .nav-button {
            width: 28px;
            height: 28px;
            font-size: 1.1rem;
          }
        }
      }

      .product-info {
        gap: 1rem;

        .product-name {
          font-size: 1.5rem;
        }

        .product-price {
          font-size: 1.3rem;
        }

        .product-description {
          font-size: 0.85rem;
          line-height: 1.5;
        }

        .product-code {
          font-size: 0.8rem;
        }

        .product-actions {
          gap: 0.5rem;
          margin-top: 0.75rem;

          .wishlist-button {
            width: 38px;
            height: 38px;
          }

          .quantity-controls {
            gap: 0.25rem;
            padding: 0.2rem;

            button {
              width: 28px;
              height: 28px;
              font-size: 1rem;
            }
          }

          .cart-button {
            height: 40px;
            font-size: 0.9rem;
            border-radius: 0.4rem;
          }

          .discount-info {
            padding: 0.3rem 0.5rem;

            .discount-tier {
              font-size: 0.7rem;
            }
          }

          .discount-subtotal {
            padding: 0.4rem;

            .subtotal-original {
              font-size: 0.75rem;
            }

            .subtotal-discount {
              font-size: 0.85rem;
            }
          }
        }
      }
    }

    .related-products {
      margin-top: 1.5rem;

      h2 {
        font-size: 1.25rem;
      }

      .products {
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;

        .product {
          padding: 0.75rem;
          border-radius: 0.75rem;

          .name {
            font-size: 0.9rem;
            margin-top: 0.5rem;
          }

          .price {
            font-size: 1rem;
            margin-top: 0.25rem;
          }
        }
      }
    }
  }
}
}
