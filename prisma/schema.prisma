generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(uuid())
  address    Address?    @relation(fields: [addressId], references: [id])
  orders     Order[]
  wishlist   WishList[]
  cart       Cart[]

  username   String
  email      String      @unique
  password   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  addressId  String?     @unique
}

model Address {
  id         String    @id @default(uuid())
  user       User?

  street     String
  city       String
  state      String
  postalCode String
  country    String
}

model WishList {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])

  userId     String
  productId  String

  @@unique([userId, productId])
}

model Cart {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])

  userId        String
  productId    String
  quantity     Int       @default(1)
  selectedSize String?
  selectedColor String?
  selectedTacoOption String?

  @@unique([userId, productId, selectedSize, selectedColor, selectedTacoOption])
}

model Product {
  id         String     @id @default(cuid())
  orderItems OrderItem[]
  wishLists  WishList[]
  carts      Cart[]

  name       String
  photo      String
  price      Float
  category   String
  stock      Int
  code       String?
  sizes      String[]
  colors    String[]
  photos    Json?
  description String?
  tacoOptions String[]
}

model OrderItem {
  id         String   @id @default(uuid())
  order      Order    @relation(fields: [orderId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  quantity   Int

  orderId    String
  productId  String
}

model Order {
  id         String      @id @default(uuid())
  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]

  status     String
  total      Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  userId     String

  // Recipient data captured at checkout — Zipnova's create-shipment
  // endpoint requires name, document (DNI) and phone, none of which are
  // stored on User/Address. Per-order snapshot.
  recipientName     String?
  recipientDocument String?
  recipientPhone    String?

  // Snapshot of the chosen quote option + items, used by the webhook to
  // create the Zipnova shipment once payment is approved. Storing it here
  // avoids re-deriving the cart (which is cleared on approval) at webhook
  // time. Shape: { serviceType, logisticType, carrierId, pickupPointId?,
  //   declaredValue, shippingCost, items: [{weight,height,width,length,description}] }
  shippingSelection Json?

  // Result of the Zipnova shipment creation, populated by the webhook.
  shipmentId     String?
  trackingNumber String?
  trackingUrl    String?
  shipmentStatus String?

  // Coupon applied at checkout. couponId is the relation; couponCode and
  // discountAmount are snapshots so /orders can show the discount even if the
  // coupon row is later deleted or edited.
  couponId       String?
  coupon         Coupon?  @relation(fields: [couponId], references: [id])
  couponCode     String?
  discountAmount Float    @default(0)
}

model Coupon {
  id         String   @id @default(uuid())
  code       String   @unique
  type       String   // "PERCENT" | "FIXED"
  value      Float    // percent (0-100) or fixed ARS amount
  active     Boolean  @default(true)
  expiresAt  DateTime?
  usageLimit Int?     // null = unlimited (within one-per-user)
  usedCount  Int      @default(0)
  onePerUser Boolean  @default(true)
  createdAt  DateTime @default(now())

  orders     Order[]
}